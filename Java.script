function doGet() {
  var template = HtmlService.createTemplateFromFile('Index');
  
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var dbSheet = ss.getSheetByName("Output Database");
  
  // បញ្ជូន Links ទៅកាន់ HTML តាំងពីពេល Load ទំព័រដំបូង
  template.sheetUrl = ss.getUrl();
  
  var gid = dbSheet ? dbSheet.getSheetId() : 0;
  template.pdfUrl = ss.getUrl().replace(/\/edit.*$/, '') + '/export?format=pdf&size=A4&portrait=false&fitw=true&gid=' + gid;
  
  return template.evaluate()
      .setTitle('ប្រព័ន្ធគ្រប់គ្រងជីវប្រវត្តិសិស្ស')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// មុខងារបញ្ចូលទិន្នន័យ Form
function processWebForm(data) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var dbSheet = ss.getSheetByName("Output Database");
    
    if (!dbSheet) {
      return { success: false, message: "មិនរកឃើញ Sheet ឈ្មោះ 'Output Database' ឡើយ!" };
    }

    var lastRow = dbSheet.getLastRow();
    var autoNo = 1;
    if (lastRow > 1) {
      var lastNoValue = dbSheet.getRange(lastRow, 1).getValue();
      autoNo = (!isNaN(lastNoValue) && lastNoValue !== "") ? Number(lastNoValue) + 1 : lastRow;
    }

    var formattedDob = data.dob || "";
    if (data.dob && data.dob.indexOf('-') !== -1) {
      var parts = data.dob.split('-');
      if (parts.length === 3) {
        formattedDob = parts[2] + '/' + parts[1] + '/' + parts[0];
      }
    }

    var newRow = [
      autoNo,
      data.studentId || "",
      data.fullName || "",
      data.gender || "",
      formattedDob,
      data.address || "",
      data.studentPhone || "",
      data.fatherName || "",
      data.fatherJob || "",
      data.fatherAddress || "",
      data.fatherPhone || "",
      data.motherName || "",
      data.motherJob || "",
      data.motherAddress || "",
      data.motherPhone || "",
      data.deskNo || "",
      data.roomNo || "",
      data.examSession || "",
      data.examCenter || "",
      data.note || ""
    ];

    dbSheet.appendRow(newRow);
    return { success: true, message: "រក្សាទុកទិន្នន័យសិស្សឈ្មោះ '" + data.fullName + "' ជោគជ័យ!" };
  } catch (error) {
    return { success: false, message: error.toString() };
  }
}
