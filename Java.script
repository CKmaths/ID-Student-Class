// ១. បើកបង្ហាញ Web App Interface
function doGet() {
  return HtmlService.createTemplateFromFile('Index')
      .evaluate()
      .setTitle('ប្រព័ន្ធគ្រប់គ្រងជីវប្រវត្តិសិស្ស')
      .addMetaTag('viewport', 'width=device-width, initial-scale=1')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// ពីរ. ទទួលទិន្នន័យពី Form ហើយបញ្ចូលទៅកាន់ Sheet "Output Database"
function processWebForm(data) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var dbSheet = ss.getSheetByName("Output Database");
  
  if (!dbSheet) {
    throw new Error("មិនរកឃើញ Sheet ឈ្មោះ 'Output Database' ឡើយ!");
  }

  // គណនាលេខរៀង Auto
  var lastRow = dbSheet.getLastRow();
  var autoNo = 1;
  if (lastRow > 1) {
    var lastNoValue = dbSheet.getRange(lastRow, 1).getValue();
    autoNo = (!isNaN(lastNoValue) && lastNoValue !== "") ? Number(lastNoValue) + 1 : lastRow;
  }

  // រៀបចំថ្ងៃខែឆ្នាំកំណើត
  var formattedDob = data.dob;
  if (data.dob) {
    var parts = data.dob.split('-'); // yyyy-mm-dd
    if (parts.length === 3) {
      formattedDob = parts[2] + '/' + parts[1] + '/' + parts[0]; // dd/mm/yyyy
    }
  }

  // រៀបចំរចនាសម្ព័ន្ធ Array សម្រាប់ Append ចូល Database
  var newRow = [
    autoNo,
    data.studentId,
    data.fullName,
    data.gender,
    formattedDob,       // ថ្ងៃខែឆ្នាំកំណើត (បន្ទាប់ពី ភេទ)
    data.address,
    data.studentPhone,
    data.fatherName,
    data.fatherJob,
    data.fatherAddress,
    data.fatherPhone,
    data.motherName,
    data.motherJob,
    data.motherAddress,
    data.motherPhone,
    data.deskNo,
    data.roomNo,
    data.examSession,
    data.examCenter,
    data.note
  ];

  dbSheet.appendRow(newRow);
  return "ជីវប្រវត្តិសិស្សឈ្មោះ '" + data.fullName + "' ត្រូវបានបញ្ចូលទៅក្នុង Database រួចរាល់!";
}

// បី. ទាញយក Link Google Sheet
function getSpreadsheetUrl() {
  return SpreadsheetApp.getActiveSpreadsheet().getUrl();
}
